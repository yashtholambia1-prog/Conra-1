        <div class="app-user" style="justify-content:center; margin-bottom:10px;"><div class="av" id="profAvatar">U</div></div>
        <h3 id="profName">User</h3>
        <p style="color:var(--muted); font-size:13px; margin-top:4px;" id="profEmail">user@gmail.com</p>
        <div class="chip-wrap" id="profInterests" style="margin-top:14px;"></div>
      </div>
    </div>
  </div>

  <div class="tab-bar">
    <button class="tab-btn active" data-tab="feed" onclick="switchTab('feed')"><span class="icon">🏠</span>Feed</button>
    <button class="tab-btn" data-tab="communities" onclick="switchTab('communities')"><span class="icon">👥</span>Communities</button>
    <button class="tab-btn" data-tab="learn" onclick="switchTab('learn')"><span class="icon">📖</span>Learn</button>
    <button class="tab-btn" data-tab="enjoy" onclick="switchTab('enjoy')"><span class="icon">🎉</span>Enjoy</button>
