<button class="admin-fab" id="adminFab" onclick="openAdmin()" title="Admin Dashboard">📊</button>

<script>
/* ================= STATE (in-memory + localStorage, simulating a backend DB) ================= */
let currentUser = null;
let selectedInterests = [];
let feed = [
  {id:1, user:"sunshine_22", text:"Weekend trip = instant happiness 🚗", likes:128, liked:false},
  {id:2, user:"wordsmithh", text:"Some days you win, some days you learn. 💗", likes:96, liked:false},
  {id:3, user:"fit.and.fierce", text:"Stronger than yesterday 🔥", likes:132, liked:false},
];
let postIdCounter = 4;

function loadDB(){ try{ return JSON.parse(localStorage.getItem('conra_activity')||'[]'); }catch(e){ return []; } }
function saveDB(rows){ localStorage.setItem('conra_activity', JSON.stringify(rows)); }

function track(action, detail){
  const rows = loadDB();
  rows.push({
    time: new Date().toLocaleString(),
    user: currentUser ? currentUser.email : 'anonymous',
    action: action,
    detail: detail || ''
  });
  saveDB(rows);
}

/* ================= OVERLAY HELPERS ================= */
function openOverlay(id){ document.getElementById(id).classList.add('show'); }
function closeOverlay(id){ document.getElementById(id).classList.remove('show'); }
function openAuth(){ track('open_auth_modal'); openOverlay('authOverlay'); }

/* ================= AUTH ================= */
function googleSignIn(){
  // Placeholder for real Google Identity Services flow.
  // To go live: init google.accounts.id with your OAuth Client ID and call prompt(),
  // then decode the returned JWT credential for name/email.
  const fakeName = "Priya Sharma";
  const fakeEmail = "priya.sharma" + Math.floor(Math.random()*900+100) + "@gmail.com";
  signInAs(fakeName, fakeEmail, 'google');
}
function demoSignIn(){
  const name = document.getElementById('demoName').value.trim() || 'Guest User';
  const email = document.getElementById('demoEmail').value.trim() || 'guest@gmail.com';
  signInAs(name, email, 'demo_email');
}
function signInAs(name, email, method){
  currentUser = {name, email, method, loginTime: new Date().toLocaleString()};
  track('login', method);
  closeOverlay('authOverlay');
  openOverlay('onboardOverlay');
}

/* ================= ONBOARDING ================= */
document.getElementById('chipWrap').addEventListener('click', e=>{
  if(e.target.classList.contains('chip')){
    e.target.classList.toggle('sel');
  }
});
function finishOnboarding(){
  selectedInterests = [...document.querySelectorAll('#chipWrap .chip.sel')].map(c=>c.dataset.v);
  track('onboarding_complete', selectedInterests.join(', '));
  closeOverlay('onboardOverlay');
  enterApp();
}

/* ================= ENTER APP ================= */
function enterApp(){
  document.getElementById('appMode').style.display = 'block';
  document.querySelector('.nav').style.display = 'none';
  document.querySelector('.hero').style.display = 'none';
  document.getElementById('userAvatar').textContent = currentUser.name[0].toUpperCase();
  document.getElementById('userNameLabel').textContent = currentUser.name;
  document.getElementById('profAvatar').textContent = currentUser.name[0].toUpperCase();
  document.getElementById('profName').textContent = currentUser.name;
  document.getElementById('profEmail').textContent = currentUser.email;
  document.getElementById('profInterests').innerHTML = selectedInterests.map(i=>`<span class="chip sel">${i}</span>`).join('') || '<span style="color:var(--muted); font-size:13px;">No interests picked</span>';
  renderFeed();
  window.scrollTo(0,0);
}
function logout(){
  track('logout');
  document.getElementById('appMode').style.display='none';
  document.querySelector('.nav').style.display='';
  document.querySelector('.hero').style.display='';
  currentUser = null;
  window.scrollTo(0,0);
}

/* ================= TABS ================= */
function switchTab(tab){
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.toggle('active', b.dataset.tab===tab));
  document.querySelectorAll('.app-panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('panel-'+tab).classList.add('active');
  track('switch_tab', tab);
}

/* ================= FEED ================= */
function renderFeed(){
  const list = document.getElementById('feedList');
  list.innerHTML = feed.slice().reverse().map(p=>`
    <div class="post">
      <div class="who"><div class="avatar"></div><b>${p.user}</b>&nbsp;· just now</div>
      <p>${p.text}</p>
      <div class="actions">
        <button class="${p.liked?'liked':''}" onclick="toggleLike(${p.id})">❤️ ${p.likes}</button>
        <button>💬 Comment</button>
        <button>🔖 Save</button>
      </div>
    </div>`).join('');
}
function addPost(){
  const val = document.getElementById('postInput').value.trim();
  if(!val) return;
  feed.push({id:postIdCounter++, user: currentUser.name, text: val, likes:0, liked:false});
  track('create_post', val.slice(0,60));
  document.getElementById('postInput').value='';
  renderFeed();
}
function toggleLike(id){
  const p = feed.find(x=>x.id===id);
  p.liked = !p.liked;
  p.likes += p.liked ? 1 : -1;
  track('like_post', p.user + (p.liked?' [liked]':' [unliked]'));
  renderFeed();
}
function joinCommunity(name){
  track('join_community', name);
  alert("Joined \"" + name + "\" ✅ (tracked to backend)");
}
function startPomodoro(){
  track('start_pomodoro');
  alert("⏱️ 25:00 Pomodoro started — stay focused!");
}

/* ================= ADMIN DASHBOARD ================= */
function openAdmin(){
  track('open_admin_dashboard');
  renderAdmin();
  openOverlay('adminOverlay');
}
function renderAdmin(){
  const rows = loadDB();
  const tbody = document.querySelector('#dataTable tbody');
  tbody.innerHTML = rows.slice().reverse().map(r=>`<tr><td>${r.time}</td><td>${r.user}</td><td>${r.action}</td><td>${r.detail}</td></tr>`).join('');
  const uniqueUsers = new Set(rows.map(r=>r.user)).size;
  document.getElementById('adminStats').innerHTML = `
    <div class="s"><b>${rows.length}</b><span>Total events</span></div>
    <div class="s"><b>${uniqueUsers}</b><span>Unique users</span></div>
    <div class="s"><b>${feed.length}</b><span>Total posts</span></div>
    <div class="s"><b>${rows.filter(r=>r.action==='login').length}</b><span>Logins</span></div>`;
}
function exportCSV(){
  const rows = loadDB();
  let csv = "Time,User,Action,Detail\n";
  rows.forEach(r=>{
    csv += `"${r.time}","${r.user}","${r.action}","${(r.detail||'').replace(/"/g,'""')}"\n`;
  });
  const blob = new Blob([csv], {type:'text/csv'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'conra_user_activity.csv';
  a.click();
  track('export_csv');
}
function clearData(){
  if(confirm("Clear all tracked activity data?")){
    saveDB([]);
    renderAdmin();
  }
}

/* mark first page view */
track('page_view', 'landing');
</script>
</body>
</html>
