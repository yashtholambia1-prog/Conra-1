  <div class="app-shell">
    <!-- FEED -->
    <div class="app-panel active" id="panel-feed">
      <div class="composer">
        <textarea id="postInput" placeholder="What's on your mind?"></textarea>
        <div class="row"><button class="btn btn-grad" onclick="addPost()">Post</button></div>
