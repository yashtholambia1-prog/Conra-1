        <div class="mini-card"><div class="ic">🎉</div><h4>Party Together</h4><p>Dance & celebrate</p><button onclick="joinCommunity('Party')">RSVP</button></div>
        <div class="mini-card"><div class="ic">🎤</div><h4>Sing. Share. Shine.</h4><p>Your voice, your stage</p><button onclick="joinCommunity('Karaoke')">Join</button></div>
        <div class="mini-card"><div class="ic">🎮</div><h4>Games & Challenges</h4><p>Friendly competition</p><button onclick="joinCommunity('Game Night')">Play</button></div>
