<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>CONRA — Connect. Learn. Grow.</title>
<style>
:root{
  --bg:#0a0612;
  --bg2:#120a1f;
  --panel:#160d24;
  --panel2:#1c1130;
  --pink:#ff3e9e;
  --pink2:#ff6bc1;
  --purple:#9b5cff;
  --purple2:#7b3ff2;
  --grad: linear-gradient(90deg,var(--pink),var(--purple));
  --text:#f5f1fa;
  --muted:#b9aecb;
  --line:rgba(255,255,255,0.09);
  --green:#3ddc84;
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:'Segoe UI',ui-sans-serif,system-ui,-apple-system,sans-serif;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
::selection{background:var(--pink); color:#fff;}
a{color:inherit; text-decoration:none;}
button{font-family:inherit; cursor:pointer;}
.wrap{max-width:1180px; margin:0 auto; padding:0 20px;}
img{max-width:100%; display:block;}

/* ---------- NAV ---------- */
.nav{
  position:fixed; top:0; left:0; right:0; z-index:200;
  background:rgba(10,6,18,0.75);
  backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line);
}
.nav-inner{display:flex; align-items:center; justify-content:space-between; height:64px;}
.logo{font-size:22px; font-weight:900; letter-spacing:3px;}
.logo span{background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent;}
.logo small{display:block; font-size:9px; letter-spacing:3px; color:var(--muted); font-weight:600;}
.nav-links{display:flex; gap:28px; font-size:14px; color:var(--muted); font-weight:600;}
.nav-links a:hover{color:var(--pink2);}
.nav-cta{display:flex; align-items:center; gap:10px;}
.btn{
  padding:10px 20px; border-radius:999px; border:none; font-weight:700; font-size:14px;
  transition:transform .15s ease, box-shadow .15s ease;
}
.btn:active{transform:scale(.96);}
.btn-grad{background:var(--grad); color:#fff; box-shadow:0 6px 20px rgba(255,62,158,.35);}
.btn-grad:hover{box-shadow:0 8px 26px rgba(255,62,158,.5);}
.btn-outline{background:transparent; color:var(--text); border:1.5px solid var(--line);}
.btn-outline:hover{border-color:var(--pink2);}
.hide-mobile{display:flex;}
@media(max-width:860px){.hide-mobile{display:none;}}

/* ---------- HERO ---------- */
.hero{
  padding:150px 0 90px;
  position:relative;
  background:
    radial-gradient(60% 50% at 15% 10%, rgba(255,62,158,.18), transparent 60%),
    radial-gradient(50% 50% at 90% 20%, rgba(123,63,242,.22), transparent 60%),
    var(--bg);
}
.hero-grid{display:grid; grid-template-columns:1.1fr .9fr; gap:50px; align-items:center;}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr;}}
.eyebrow{
  display:inline-flex; align-items:center; gap:8px;
  border:1px solid var(--line); padding:7px 14px; border-radius:999px;
  font-size:12.5px; color:var(--pink2); font-weight:700; margin-bottom:22px;
  background:rgba(255,62,158,.06);
}
.eyebrow::before{content:"●"; color:var(--green); font-size:9px;}
h1.hero-title{font-size:52px; line-height:1.08; font-weight:900; letter-spacing:-1px;}
@media(max-width:600px){h1.hero-title{font-size:36px;}}
h1.hero-title .grad{background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent;}
.hero-sub{margin-top:20px; color:var(--muted); font-size:17px; max-width:520px; line-height:1.6;}
.hero-actions{display:flex; gap:14px; margin-top:32px; flex-wrap:wrap;}
.hero-stats{display:flex; gap:34px; margin-top:44px; flex-wrap:wrap;}
.stat b{font-size:26px; display:block; background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent;}
.stat span{font-size:12.5px; color:var(--muted);}

/* phone mock */
.phone{
  width:290px; margin:0 auto; border-radius:34px; border:8px solid #241432;
  background:linear-gradient(180deg,#1a0f2a,#0d0716);
  box-shadow:0 30px 70px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.04);
  overflow:hidden;
}
.phone-head{display:flex; align-items:center; justify-content:space-between; padding:16px 16px 10px; font-size:13px; font-weight:800; letter-spacing:2px;}
.phone-body{padding:0 12px 16px; display:flex; flex-direction:column; gap:10px;}
.pcard{background:var(--panel2); border:1px solid var(--line); border-radius:14px; padding:12px;}
.pcard .who{display:flex; align-items:center; gap:8px; font-size:11px; color:var(--muted); margin-bottom:8px;}
.avatar{width:22px; height:22px; border-radius:50%; background:var(--grad); flex-shrink:0;}
.pcard p{font-size:12.5px; line-height:1.4;}
.pcard .stats{display:flex; gap:14px; margin-top:8px; font-size:11px; color:var(--muted);}

/* ---------- SECTIONS ---------- */
section{padding:90px 0;}
.section-head{text-align:center; max-width:640px; margin:0 auto 50px;}
.section-tag{color:var(--pink2); font-weight:800; font-size:12.5px; letter-spacing:2px; text-transform:uppercase;}
.section-title{font-size:36px; font-weight:900; margin-top:10px; letter-spacing:-.5px;}
@media(max-width:600px){.section-title{font-size:27px;}}
.section-title .grad{background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent;}
.section-sub{color:var(--muted); margin-top:14px; font-size:15.5px; line-height:1.6;}

.grid4{display:grid; grid-template-columns:repeat(4,1fr); gap:16px;}
.grid3{display:grid; grid-template-columns:repeat(3,1fr); gap:16px;}
@media(max-width:900px){.grid4{grid-template-columns:repeat(2,1fr);} .grid3{grid-template-columns:repeat(2,1fr);}}
@media(max-width:560px){.grid4,.grid3{grid-template-columns:1fr;}}

.card{
  background:var(--panel); border:1px solid var(--line); border-radius:18px; padding:24px;
  transition:transform .18s ease, border-color .18s ease;
}
.card:hover{transform:translateY(-4px); border-color:rgba(255,110,190,.35);}
.card .ic{
  width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center;
  background:var(--grad); font-size:20px; margin-bottom:14px;
}
.card h3{font-size:16.5px; font-weight:800; margin-bottom:6px;}
.card p{color:var(--muted); font-size:13.5px; line-height:1.5;}

.band{
  background:var(--panel); border:1px solid var(--line); border-radius:20px;
  padding:18px 26px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;
  margin-top:20px;
}
.band .l{display:flex; align-items:center; gap:10px; font-weight:700; font-size:14.5px;}
.band .r{color:var(--pink2); font-weight:800; font-size:13.5px;}

/* trust strip */
.trust{
  border:1px solid var(--line); border-radius:20px; padding:22px 26px;
  display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;
  background:linear-gradient(90deg, rgba(255,62,158,.07), rgba(123,63,242,.07));
}
.trust b{display:block; font-size:15px;}
.trust span{color:var(--muted); font-size:12.5px;}

footer{border-top:1px solid var(--line); padding:34px 0; text-align:center; color:var(--muted); font-size:13px;}

/* ---------- APP MODE (post-login MVP) ---------- */
#appMode{display:none; min-height:100vh; background:var(--bg);}
.app-topbar{
  position:sticky; top:0; z-index:150; background:rgba(10,6,18,.9); backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between;
  padding:12px 18px;
}
.app-user{display:flex; align-items:center; gap:10px; font-size:13px;}
.app-user .av{width:32px; height:32px; border-radius:50%; background:var(--grad); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px;}
.app-shell{max-width:640px; margin:0 auto; padding:16px 14px 90px;}
.tab-bar{
  position:fixed; bottom:0; left:0; right:0; z-index:150; background:rgba(15,9,25,.95); backdrop-filter:blur(14px);
  border-top:1px solid var(--line); display:flex; justify-content:space-around; padding:10px 0 14px;
}
.tab-btn{background:none; border:none; color:var(--muted); font-size:10.5px; display:flex; flex-direction:column; align-items:center; gap:3px; font-weight:700;}
.tab-btn .icon{font-size:19px;}
.tab-btn.active{color:var(--pink2);}
.app-panel{display:none;}
.app-panel.active{display:block;}

.composer{background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:14px; margin-bottom:16px;}
.composer textarea{
  width:100%; background:var(--panel2); border:1px solid var(--line); border-radius:12px; color:var(--text);
  padding:10px 12px; font-size:14px; resize:none; min-height:44px; font-family:inherit;
}
.composer .row{display:flex; justify-content:flex-end; margin-top:10px;}
.post{background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:14px; margin-bottom:14px;}
.post .who{display:flex; align-items:center; gap:9px; font-size:12.5px; color:var(--muted); margin-bottom:8px;}
.post .who b{color:var(--text); font-size:13px;}
.post p{font-size:14.5px; line-height:1.5;}
.post .actions{display:flex; gap:18px; margin-top:10px; font-size:12.5px; color:var(--muted);}
.post .actions button{background:none; border:none; color:var(--muted); font-size:12.5px; display:flex; align-items:center; gap:5px;}
.post .actions button.liked{color:var(--pink2); font-weight:700;}

.mini-grid{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
.mini-card{background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:14px; text-align:center;}
.mini-card .ic{font-size:24px; margin-bottom:6px;}
.mini-card h4{font-size:13px; font-weight:800;}
.mini-card p{font-size:11px; color:var(--muted); margin-top:3px;}
.mini-card button{margin-top:10px; width:100%; padding:8px; border-radius:999px; border:1.5px solid var(--line); background:transparent; color:var(--text); font-size:11.5px; font-weight:700;}
.mini-card button:hover{border-color:var(--pink2); color:var(--pink2);}

.panel-title{font-size:19px; font-weight:900; margin-bottom:14px;}

/* ---------- MODALS ---------- */
.overlay{
  position:fixed; inset:0; background:rgba(5,2,10,.72); backdrop-filter:blur(4px);
  display:none; align-items:center; justify-content:center; z-index:500; padding:20px;
}
.overlay.show{display:flex;}
.modal{
  background:var(--panel); border:1px solid var(--line); border-radius:22px; padding:30px 26px;
  width:100%; max-width:380px; text-align:center; position:relative;
}
.modal .close{position:absolute; top:14px; right:16px; background:none; border:none; color:var(--muted); font-size:20px;}
.modal .glow-icon{width:56px; height:56px; border-radius:16px; background:var(--grad); margin:0 auto 16px; display:flex; align-items:center; justify-content:center; font-size:26px;}
.modal h2{font-size:20px; font-weight:900; margin-bottom:8px;}
.modal p.desc{color:var(--muted); font-size:13.5px; margin-bottom:22px; line-height:1.5;}
.g-btn{
  width:100%; display:flex; align-items:center; justify-content:center; gap:10px;
  background:#fff; color:#1f1f1f; border:none; border-radius:12px; padding:13px; font-weight:700; font-size:14.5px;
  box-shadow:0 4px 14px rgba(0,0,0,.25);
}
.divider{display:flex; align-items:center; gap:10px; color:var(--muted); font-size:11.5px; margin:16px 0;}
.divider::before,.divider::after{content:""; flex:1; height:1px; background:var(--line);}
.demo-input{width:100%; padding:12px 14px; border-radius:12px; background:var(--panel2); border:1px solid var(--line); color:var(--text); font-size:14px; margin-bottom:10px;}
.small-note{font-size:11px; color:var(--muted); margin-top:14px; line-height:1.5;}

/* onboarding */
.chip{display:inline-block; padding:9px 16px; border-radius:999px; border:1.5px solid var(--line); font-size:13px; font-weight:700; margin:5px; cursor:pointer; transition:.15s;}
.chip.sel{background:var(--grad); border-color:transparent; color:#fff;}
.chip-wrap{display:flex; flex-wrap:wrap; justify-content:center; margin:16px 0 22px;}

/* admin */
.admin-fab{
  position:fixed; bottom:90px; right:18px; z-index:160; background:var(--panel); border:1px solid var(--line);
  color:var(--muted); width:44px; height:44px; border-radius:50%; font-size:16px; display:flex; align-items:center; justify-content:center;
  box-shadow:0 8px 24px rgba(0,0,0,.4);
}
#adminOverlay .modal{max-width:680px; text-align:left; max-height:82vh; overflow-y:auto;}
table.dt{width:100%; border-collapse:collapse; font-size:11.5px; margin-top:14px;}
table.dt th{background:var(--panel2); text-align:left; padding:8px; position:sticky; top:0; color:var(--pink2);}
table.dt td{padding:7px 8px; border-bottom:1px solid var(--line); color:var(--muted);}
.admin-stats{display:flex; gap:10px; flex-wrap:wrap; margin-top:14px;}
.admin-stats .s{background:var(--panel2); border-radius:12px; padding:10px 14px; flex:1; min-width:100px; text-align:center;}
.admin-stats .s b{display:block; font-size:20px; background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent;}
.admin-stats .s span{font-size:10.5px; color:var(--muted);}
</style>
</head>
